# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL connection string.
# Host port is 5433, not 5432 - see docker-compose.yml (5432 was already taken
# locally). Inside Docker, the backend container talks to the `db` service on
# its container-internal 5432 instead (overridden by docker-compose.yml).
DATABASE_URL=postgresql://resolve:resolve@localhost:5433/resolve

# Used only by the test suite, to keep test data out of the dev database.
# Defaults to DATABASE_URL with the db name swapped to resolve_test if unset.
TEST_DATABASE_URL=postgresql://resolve:resolve@localhost:5433/resolve_test

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173

# AI provider (OpenAI-compatible)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
