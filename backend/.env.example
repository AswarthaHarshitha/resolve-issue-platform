# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL connection string.
# Local dev: host port is 5433, not 5432 - see docker-compose.yml (5432 was
# already taken locally). Inside Docker, the backend container talks to the
# `db` service on its container-internal 5432 instead (overridden by
# docker-compose.yml).
# Production (e.g. Supabase): use the connection *pooler* URI, not the
# direct db.<ref>.supabase.co string - the direct host is IPv6-only and
# unreachable from most free-tier platform egress (see README's
# "Production deployment" section).
DATABASE_URL=postgresql://resolve:resolve@localhost:5433/resolve

# Used only by the test suite, to keep test data out of the dev database.
# Defaults to DATABASE_URL with the db name swapped to resolve_test if unset.
TEST_DATABASE_URL=postgresql://resolve:resolve@localhost:5433/resolve_test

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173

# In-memory, single-process rate limiting for /auth/login and /auth/register
# (not a distributed limiter - see DECISIONS.md D25)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# AI provider (OpenAI-compatible). Point OPENAI_BASE_URL at any
# OpenAI-compatible endpoint to use a different provider - e.g. Google's
# Gemini offers one at https://generativelanguage.googleapis.com/v1beta/openai/.
# Leave OPENAI_BASE_URL unset to use the real OpenAI API.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# How long a resolver/admin must wait between manual reanalysis attempts on
# the same issue (DECISIONS.md D13)
AI_REANALYZE_COOLDOWN_SECONDS=120
